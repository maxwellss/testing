# Copy this file to .env and adjust. .env is ignored by git, so secrets stay on your computer.

# --- Filters: a token must pass ALL of these to trigger an alert ---
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_1H_USD=5000
MIN_BUYS_1H=20
MIN_BUY_SELL_RATIO=1.0
MIN_AGE_MINUTES=5
MAX_AGE_HOURS=24
MAX_MARKET_CAP_USD=5000000
USE_RUGCHECK=true

# --- How often to scan (seconds) ---
POLL_SECONDS=60

# --- Optional: Telegram alerts (leave blank for console + CSV only) ---
# 1. In Telegram, message @BotFather, send /newbot, copy the token below.
# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
